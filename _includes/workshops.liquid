<div class="publications">
  {% assign workshops_by_year = site.data.workshops | group_by: 'year' %}
  {% for year in workshops_by_year %}
    <h2 class="bibliography">{{ year.name }}</h2>
    <ol class="bibliography">
      {% for workshop in year.items %}
        <li>
          <div class="title">{{ workshop.title }}</div>
          <div class="author">
            {{ workshop.host }}
            {%- if workshop.location %}, {{ workshop.location }}{% endif -%}
            {%- if workshop.role %} · {{ workshop.role }}{% endif -%}
            {%- if workshop.with %} · with {{ workshop.with }}{% endif %}
          </div>
          <div class="periodical">
            <em>{{ workshop.date }}</em>
          </div>
          {% if workshop.links %}
            <div class="links">
              {% for link in workshop.links %}
                <a href="{{ link[1] }}" class="btn btn-sm z-depth-0" role="button">{{ link[0] }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endfor %}
</div>
